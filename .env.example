# GEMINI_API_KEY: Required for DT AI CORE generative synthesis (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SQLITE_DB_PATH: Optional path to the relational SQLite database file.
SQLITE_DB_PATH="./data/dt_edtech.sqlite"

# DT_BOOTSTRAP_KEY: Optional server-side key required to initialize the first Platform Owner account.
DT_BOOTSTRAP_KEY=""

# Optional SMTP configuration for outgoing school announcements & direct notification emails
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Optional Firebase Cloud Messaging (FCM) configuration for mobile push delivery
FCM_PROJECT_ID=""
FCM_SERVICE_ACCOUNT_JSON=""

# Optional Telegram Bot override (recommended to configure via Owner -> Telegram Bot Console instead)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
